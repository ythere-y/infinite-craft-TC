{
  "name": "infinity-craft-edgeone-makers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose up --build --remove-orphans",
    "dev:down": "docker compose down",
    "build": "node scripts/build-makers.mjs",
    "makers:build": "edgeone makers build",
    "generate:makers-data": "node scripts/generate-makers-data.mjs",
    "generate:makers-prompt-data": "node scripts/generate-makers-prompt-data.mjs",
    "generate:makers-nickname-data": "node scripts/generate-makers-nickname-data.mjs",
    "refresh:nickname-corpus": "node scripts/refresh-nickname-corpus.mjs",
    "generate:icons": "node scripts/generate-icon-assets.mjs",
    "generate:icon-data": "node scripts/generate-icon-data.mjs",
    "audit:icons": "node scripts/audit-icon-map.mjs",
    "verify:icons": "node scripts/verify-icon-assets.mjs",
    "test": "node --test --test-concurrency=1 tests-makers/*.test.mjs"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1"
  }
}
